{
  "name": "tonkic-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tonkic personal website rebuilt with Next.js and TypeScript.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check": "tsc --noEmit",
    "test": "npm run check && npm run test:unit && npm run build && npm run test:static",
    "test:unit": "node --test scripts/*.test.mjs",
    "test:static": "node scripts/random-user-journey.mjs",
    "sync:blog": "node scripts/sync-obsidian-blog.mjs",
    "sync:relay": "node scripts/sync-relay-snapshot.mjs"
  },
  "dependencies": {
    "framer-motion": "^13.1.1",
    "fumadocs-core": "^16.15.1",
    "katex": "^0.18.4",
    "lenis": "^1.3.26",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^7.0.2"
  }
}
